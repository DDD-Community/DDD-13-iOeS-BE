{
  "groups": [
    {
      "name": "backup-failure-alerts",
      "folder": "Backup",
      "interval": 300,
      "rules": [
        {
          "title": "DB 백업 실패",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "queryType": "range",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "loki",
              "model": {
                "expr": "count_over_time({job=\"backup\", level=\"ERROR\", type=\"db\"}[5m])",
                "queryType": "range",
                "refId": "A"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "DB 백업 스크립트에서 ERROR 로그가 감지되었습니다.",
            "description": "백업 로그에서 level=ERROR, type=db 항목이 발생했습니다. /home/ubuntu/DDD-13-iOeS-BE/deploy/backup/logs/backup-db.log 를 확인하세요."
          },
          "labels": {
            "severity": "critical",
            "type": "db"
          },
          "isPaused": false
        },
        {
          "title": "로그 백업 실패",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "queryType": "range",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "loki",
              "model": {
                "expr": "count_over_time({job=\"backup\", level=\"ERROR\", type=\"applog\"}[5m])",
                "queryType": "range",
                "refId": "A"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "로그 백업 스크립트에서 ERROR 로그가 감지되었습니다.",
            "description": "백업 로그에서 level=ERROR, type=applog 항목이 발생했습니다. /home/ubuntu/DDD-13-iOeS-BE/deploy/backup/logs/backup-logs.log 를 확인하세요."
          },
          "labels": {
            "severity": "critical",
            "type": "applog"
          },
          "isPaused": false
        }
      ]
    },
    {
      "name": "backup-missing-alerts",
      "folder": "Backup",
      "interval": 3600,
      "rules": [
        {
          "title": "DB 백업 미실행 (7일)",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "queryType": "range",
              "relativeTimeRange": {
                "from": 612000,
                "to": 0
              },
              "datasourceUid": "loki",
              "model": {
                "expr": "absent_over_time({job=\"backup\", type=\"db\"}[170h])",
                "queryType": "range",
                "refId": "A"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "7일간 DB 백업 로그가 없습니다. Cron 등록 여부를 확인하세요.",
            "description": "지난 7일간 {job=\"backup\", type=\"db\"} 로그가 수집되지 않았습니다. Cron 또는 Promtail 상태를 점검하세요."
          },
          "labels": {
            "severity": "warning",
            "type": "db"
          },
          "isPaused": false
        },
        {
          "title": "로그 백업 미실행 (30일)",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "queryType": "range",
              "relativeTimeRange": {
                "from": 2599200,
                "to": 0
              },
              "datasourceUid": "loki",
              "model": {
                "expr": "absent_over_time({job=\"backup\", type=\"applog\"}[722h])",
                "queryType": "range",
                "refId": "A"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "30일간 로그 백업 로그가 없습니다. Cron 등록 여부를 확인하세요.",
            "description": "지난 30일간 {job=\"backup\", type=\"applog\"} 로그가 수집되지 않았습니다. Cron 또는 Promtail 상태를 점검하세요."
          },
          "labels": {
            "severity": "warning",
            "type": "applog"
          },
          "isPaused": false
        }
      ]
    }
  ]
}
