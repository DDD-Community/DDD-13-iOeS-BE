      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"photo-app\", level=~\"$level\"} | json | userId=`$userId` | line_format \"[{{.level}}] [rid:{{.requestId}}] {{.logger_name}} - {{.message}}{{if .stack_trace}}\\n  {{.stack_trace}}{{end}}\"",
          "legendFormat": ""
        }
      ],
      "title": "userId 기반 로그 조회",
