      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"photo-app\", level=\"ERROR\"} | json | line_format \"[{{.requestId}}] [uid:{{.userId}}] {{.logger_name}}\\n  msg: {{.message}}\\n  stack: {{.stack_trace}}\"",
          "legendFormat": ""
        }
      ],
      "title": "ERROR 로그 스트림 (stack_trace 포함)",
