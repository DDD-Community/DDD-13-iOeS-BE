      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"photo-app\", level=~\"$level\"} | json | uri=~\"$uri\" | line_format \"[{{.level}}] [rid:{{.requestId}}] [uid:{{.userId}}] {{.method}} {{.uri}} - {{.message}}{{if .stack_trace}}\\n  {{.stack_trace}}{{end}}\"",
          "legendFormat": ""
        }
      ],
      "title": "URI 패턴 로그 조회",
