          "instant": true
        },
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"photo-app\", level=\"INFO\"}[$__range]))",
          "legendFormat": "INFO 건수",
          "instant": true
        }
      ],
      "title": "레벨별 로그 건수 (조회 범위 기준)",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 1 } },
