      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (level) (count_over_time({job=\"photo-app\"}[5m]))",
          "legendFormat": "{{level}}"
        }
      ],
      "title": "ERROR/WARN 발생 빈도 (5분 윈도우)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
