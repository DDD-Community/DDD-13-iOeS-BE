# ─────────────────────────────────────────────────────────────
# Photo 서비스 배포용 환경 변수 템플릿
#
# 사용법:
#   1) cp .env.example .env
#   2) 아래 값 실제 값으로 채우기
#   3) docker compose up -d
#
# 주의:
#   - .env 파일은 절대 git에 커밋 금지 (.gitignore 처리됨)
#   - 모든 비밀번호는 16자 이상 랜덤 문자열 권장
#   - JWT_SECRET 생성법은 아래 해당 항목 주석 참고 (base64url 이어야 한다)
# ─────────────────────────────────────────────────────────────

# === Spring Profile ===
# test : Swagger 노출, DEBUG 로깅, actuator 다수 endpoint, show-sql=true (테스트 서버용)
# prod : Swagger 비노출, INFO 로깅, actuator health 만 노출 (운영 서버용)
SPRING_PROFILES_ACTIVE=test

# === PostgreSQL ===
POSTGRES_DB=photo
POSTGRES_USER=photo
POSTGRES_PASSWORD=change-me-strong-password

# === Redis ===
REDIS_PASSWORD=change-me-strong-password

# === Spring Boot / Security ===
# JwtProvider 가 Decoders.BASE64URL 로 디코딩하므로 base64url(A-Za-z0-9_-, 패딩 없음)이어야 한다.
# 일반 base64 는 +, /, = 를 포함할 수 있어 안전하지 않다.
# 생성: openssl rand -base64 64 | tr -d '\n' | tr '+/' '-_' | tr -d '='
JWT_SECRET=change-me-512bit-base64url-encoded-secret

# === 외부 API ===
# 공공데이터포털 (data.go.kr) - 기상청 단기예보, 천문연구원 출몰시각
DATA_GO_KR_SERVICE_KEY=

# 서울 열린데이터광장 - 실시간 인구 데이터
SEOUL_API_KEY=

# === OAuth - Kakao ===
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://pickflow-api.us/api/auth/kakao/callback
KAKAO_ADMIN_KEY=

# === OAuth - Apple ===
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://pickflow-api.us/api/auth/apple/callback

# === Grafana ===
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# === 디스코드 알림 ===
# 디스코드 채널 설정 > 연동 > 웹후크에서 생성한 URL (필수 - 비어 있으면 grafana 기동 실패)
DISCORD_WEBHOOK_URL=

# === 공유 링크 (og:url 생성용 외부 도메인) ===
# 미설정 시 https://pickflow-api.us 로 동작한다. 테스트 서버(.env.dev)에서는 반드시
# dev 도메인으로 지정해야 공유 링크가 운영 도메인을 가리키지 않는다.
SHARE_BASE_URL=https://pickflow-api.us

# === 노션 운영 지표 동기화 (매일 06시) ===
# 미설정 시 스케줄러가 스킵된다. 노션 integration 토큰과 대상 DB id.
NOTION_TOKEN=
NOTION_DATABASE_ID=
