# ─────────────────────────────────────────────────────────────
# Photo 서비스 배포용 환경 변수 템플릿
#
# 사용법:
#   1) cp .env.example .env
#   2) 아래 값 실제 값으로 채우기
#   3) docker compose up -d
#
# 주의:
#   - .env 파일은 절대 git에 커밋 금지 (.gitignore 처리됨)
#   - 모든 비밀번호는 16자 이상 랜덤 문자열 권장
#   - JWT_SECRET: openssl rand -base64 64 로 생성
# ─────────────────────────────────────────────────────────────

# === Spring Profile ===
# test : Swagger 노출, DEBUG 로깅, actuator 다수 endpoint, show-sql=true (테스트 서버용)
# prod : Swagger 비노출, INFO 로깅, actuator health 만 노출 (운영 서버용)
SPRING_PROFILES_ACTIVE=test

# === PostgreSQL ===
POSTGRES_DB=photo
POSTGRES_USER=photo
POSTGRES_PASSWORD=change-me-strong-password

# === Redis ===
REDIS_PASSWORD=change-me-strong-password

# === Spring Boot / Security ===
# 생성: openssl rand -base64 64
JWT_SECRET=change-me-256bit-base64-encoded-secret

# === 외부 API ===
# 공공데이터포털 (data.go.kr) - 기상청 단기예보, 천문연구원 출몰시각
DATA_GO_KR_SERVICE_KEY=

# 서울 열린데이터광장 - 실시간 인구 데이터
SEOUL_API_KEY=

# === OAuth - Kakao ===
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://pickflow-api.us/api/auth/kakao/callback
KAKAO_ADMIN_KEY=

# === OAuth - Apple ===
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://pickflow-api.us/api/auth/apple/callback

# === Grafana ===
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
